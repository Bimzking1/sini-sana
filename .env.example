# WebSocket URL of the Sini Sana signaling server.
# In development this points at the local signaling server.
VITE_SIGNALING_URL=ws://localhost:3001

# Comma-separated list of STUN servers used for NAT traversal.
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN relay. TURN relays traffic when a direct peer-to-peer
# connection cannot be established. Keep credentials out of version control.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=credential
